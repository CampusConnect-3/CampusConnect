@page
@model CampusConnect.Pages.Manager.ReviewRequestsModel
@{
    ViewData["Title"] = "Review Completed Requests";
}

<link rel="stylesheet" href="~/css/manager_reviewrequest.css" />

<div class="review-header">
    <h1>Review Completed Requests</h1>
    <p>Requests completed by staff and awaiting manager approval to archive.</p>
</div>

<div class="table-card">
    <table class="table table-borderless" id="review-table">
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Title of Request</th>
                <th>Created By</th>
                <th>Assigned To</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Completed At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Requests.Any())
            {
                @foreach (var item in Model.Requests)
                {
                    var createdByName = item.createdBy != null
                    ? $"{item.createdBy.fName} {item.createdBy.lName}".Trim()
                    : "Unknown";

                    var assignedToName = item.assignedTo != null
                    ? $"{item.assignedTo.fName} {item.assignedTo.lName}".Trim()
                    : "Unassigned";

                    var priorityClass = (item.priority?.ToLower()) switch
                    {
                        "high" => "priority-high",
                        "critical" => "priority-critical",
                        "medium" => "priority-medium",
                        "low" => "priority-low",
                        _ => "priority-medium"
                    };

                    // Updated status class for "Completed"
                    var statusClass = (item.status?.statusName?.ToLower().Replace(" ", "")) switch
                    {
                        "completed" => "status-completed",
                        "inprogress" => "status-inprogress",
                        "todo" => "status-todo",
                        "closed" => "status-closed",
                        _ => "status-completed"
                    };

                    <tr class="review-row">
                        <td class="ticket-id">@item.requestID</td>
                        <td class="ticket-title">@item.title</td>
                        <td class="ticket-user">@createdByName</td>
                        <td class="@(item.assignedTo != null ? "ticket-user" : "text-muted")">@assignedToName</td>
                        <td><span class="badge-pill @priorityClass">@item.priority</span></td>
                        <td><span class="badge-pill @statusClass">@item.status?.statusName</span></td>
                        <td class="ticket-date">
                            @if (item.closedAt.HasValue)
                            {
                                @item.closedAt.Value.ToString("MM/dd/yyyy hh:mm tt")
                            }
                            else
                            {
                                <span class="text-muted">Pending</span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <form method="post" asp-page-handler="Close" style="display:inline;">
                                    <input type="hidden" name="RequestId" value="@item.requestID" />
                                    <button type="submit" class="btn-close-ticket" title="Archive this completed request">
                                        <i class="bi bi-archive"></i> Archive
                                    </button>
                                </form>
                                <a asp-page="/RequestPages/Details" asp-route-id="@item.requestID" class="btn-view-ticket">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                        <p class="mt-2">No completed requests awaiting review.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-bar" id="pagination-review"></div>
</div>

@section Scripts {
    <script src="~/js/manager_reviewrequest.js"></script>
}
