@page
@model CampusConnect.Pages.Manager.QueueModel

@{
    ViewData["Title"] = "Active Request Queue";
}

<link rel="stylesheet" href="~/css/manager_queue.css" />

<div class="queue-container">

    <div class="page-header">
        <h1>📋 Active Request Queue</h1>
        <p>
            Requests are organized by priority level and sorted by submission date.
            Critical and high priority requests are expanded by default.
        </p>
    </div>

    <!-- Search & Filter Card -->
    <div class="search-card">
        <form method="get" class="row g-3">

            <!-- Category Dropdown -->
            <div class="col-md-4">
                <label class="form-label">Filter by Category</label>
                <select name="CategoryFilter" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.CategoryOptions)
                    {
                        if (cat.Value == Model.CategoryFilter?.ToString())
                        {
                            <option value="@cat.Value" selected>@cat.Text</option>
                        }
                        else
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    }
                </select>
            </div>

            <!-- Text Search -->
            <div class="col-md-5">
                <label asp-for="SearchTerm" class="form-label">Search by Ticket ID, Title, or Name</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="e.g. 1031, Broken, Kate Erickson..." />
            </div>

            <!-- Buttons — invisible label keeps vertical alignment -->
            <div class="col-md-3">
                <label class="form-label invisible">Actions</label>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <a asp-page="./Queue" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </a>
                </div>
            </div>

        </form>

        @if (Model.CategoryFilter.HasValue || !string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <div class="mt-3 d-flex align-items-center gap-2 flex-wrap">
                <span class="filter-label">Active filters:</span>
                @if (Model.CategoryFilter.HasValue)
                {
                    <span class="active-filter-tag">
                        Category: @Model.CategoryOptions.FirstOrDefault(c => c.Value == Model.CategoryFilter.ToString())?.Text
                        <a asp-page="./Queue" asp-route-SearchTerm="@Model.SearchTerm">✕</a>
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <span class="active-filter-tag">
                        Search: "@Model.SearchTerm"
                        <a asp-page="./Queue" asp-route-CategoryFilter="@Model.CategoryFilter">✕</a>
                    </span>
                }
            </div>
        }
    </div>

    <!-- Priority Summary Badges -->
    <div class="priority-badges">
        <span class="priority-badge-large bg-danger text-white">
            🔴 Critical <strong>@Model.CriticalRequests.Count</strong>
        </span>
        <span class="priority-badge-large bg-warning text-dark">
            🟡 High <strong>@Model.HighPriorityRequests.Count</strong>
        </span>
        <span class="priority-badge-large bg-primary text-white">
            🔵 Medium <strong>@Model.MediumPriorityRequests.Count</strong>
        </span>
        <span class="priority-badge-large bg-success text-white">
            🟢 Low <strong>@Model.LowPriorityRequests.Count</strong>
        </span>
    </div>

    <!-- CRITICAL PRIORITY SECTION -->
    @if (Model.CriticalRequests.Any())
    {
        <div class="card priority-section priority-critical border-0">
            <div class="priority-header text-white" data-bs-toggle="collapse" data-bs-target="#criticalSection">
                <div class="d-flex justify-content-between align-items-center">
                    <h3>🔴 Critical Priority</h3>
                    <div class="d-flex align-items-center gap-3">
                        <span class="section-count bg-white text-danger">@Model.CriticalRequests.Count</span>
                        <span class="collapse-indicator">▼</span>
                    </div>
                </div>
            </div>
            <div id="criticalSection" class="collapse show">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Submitted By</th>
                                    <th>Assigned To</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody data-section="critical">
                                @foreach (var item in Model.CriticalRequests)
                                {
                                    var createdByName = item.createdBy != null ? $"{item.createdBy.fName} {item.createdBy.lName}".Trim() : "Unknown";
                                    var assignedToName = item.assignedTo != null ? $"{item.assignedTo.fName} {item.assignedTo.lName}".Trim() : null;
                                    <tr class="queue-row">
                                        <td><span class="request-id">#@item.requestID</span></td>
                                        <td><strong>@item.title</strong></td>
                                        <td>@item.category?.categoryName</td>
                                        <td><span class="badge bg-secondary">@item.status?.statusName</span></td>
                                        <td>@createdByName</td>
                                        <td>
                                            @if (assignedToName != null)
                                            {
                                                <span class="status-assigned">✓ @assignedToName</span>
                                            }
                                            else
                                            {

                                                <span class="status-unassigned">⚠️ Unassigned</span>
                                            }
                                        </td>
                                        <td>@item.createdAt.ToString("MM/dd/yy HH:mm")</td>
                                        <td>
                                            <a asp-page="/Manager/ManageRequest" asp-route-id="@item.requestID" class="info-btn" title="View & Manage">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-bar" id="pagination-critical"></div>
                </div>
            </div>
        </div>
    }

    <!-- HIGH PRIORITY SECTION -->
    <div class="card priority-section priority-high border-0">
        <div class="priority-header text-white" data-bs-toggle="collapse" data-bs-target="#highSection">
            <div class="d-flex justify-content-between align-items-center">
                <h3>🟡 High Priority</h3>
                <div class="d-flex align-items-center gap-3">
                    <span class="section-count bg-white text-dark">@Model.HighPriorityRequests.Count</span>
                    <span class="collapse-indicator">▼</span>
                </div>
            </div>
        </div>
        <div id="highSection" class="collapse show">
            <div class="card-body">
                @if (Model.HighPriorityRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Submitted By</th>
                                    <th>Assigned To</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody data-section="high">
                                @foreach (var item in Model.HighPriorityRequests)
                                {
                                    var createdByName = item.createdBy != null ? $"{item.createdBy.fName} {item.createdBy.lName}".Trim() : "Unknown";
                                    var assignedToName = item.assignedTo != null ? $"{item.assignedTo.fName} {item.assignedTo.lName}".Trim() : null;
                                    <tr class="queue-row">
                                        <td><span class="request-id">#@item.requestID</span></td>
                                        <td><strong>@item.title</strong></td>
                                        <td>@item.category?.categoryName</td>
                                        <td><span class="badge bg-secondary">@item.status?.statusName</span></td>
                                        <td>@createdByName</td>
                                        <td>
                                            @if (assignedToName != null)
                                            {
                                                <span class="status-assigned">✓ @assignedToName</span>
                                            }
                                            else
                                            {

                                                <span class="status-unassigned-medium">⚠️ Unassigned</span>
                                            }
                                        </td>
                                        <td>@item.createdAt.ToString("MM/dd/yy HH:mm")</td>
                                        <td>
                                            <a asp-page="/Manager/ManageRequest" asp-route-id="@item.requestID" class="info-btn" title="View & Manage">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-bar" id="pagination-high"></div>
                }
                else
                {
                    <div class="empty-state"><div>🎉</div><p class="mb-0">No high priority requests at this time.</p></div>
                }
            </div>
        </div>
    </div>

    <!-- MEDIUM PRIORITY SECTION -->
    <div class="card priority-section priority-medium border-0">
        <div class="priority-header text-white" data-bs-toggle="collapse" data-bs-target="#mediumSection">
            <div class="d-flex justify-content-between align-items-center">
                <h3>🔵 Medium Priority</h3>
                <div class="d-flex align-items-center gap-3">
                    <span class="section-count bg-white text-primary">@Model.MediumPriorityRequests.Count</span>
                    <span class="collapse-indicator collapsed">▼</span>
                </div>
            </div>
        </div>
        <div id="mediumSection" class="collapse">
            <div class="card-body">
                @if (Model.MediumPriorityRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Submitted By</th>
                                    <th>Assigned To</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody data-section="medium">
                                @foreach (var item in Model.MediumPriorityRequests)
                                {
                                    var createdByName = item.createdBy != null ? $"{item.createdBy.fName} {item.createdBy.lName}".Trim() : "Unknown";
                                    var assignedToName = item.assignedTo != null ? $"{item.assignedTo.fName} {item.assignedTo.lName}".Trim() : null;
                                    <tr class="queue-row">
                                        <td><span class="request-id">#@item.requestID</span></td>
                                        <td><strong>@item.title</strong></td>
                                        <td>@item.category?.categoryName</td>
                                        <td><span class="badge bg-secondary">@item.status?.statusName</span></td>
                                        <td>@createdByName</td>
                                        <td>
                                            @if (assignedToName != null)
                                            {
                                                <span class="status-assigned">✓ @assignedToName</span>
                                            }
                                            else
                                            {

                                                <span class="text-muted fw-semibold">⚠️ Unassigned</span>
                                            }
                                        </td>
                                        <td>@item.createdAt.ToString("MM/dd/yy HH:mm")</td>
                                        <td>
                                            <a asp-page="/Manager/ManageRequest" asp-route-id="@item.requestID" class="info-btn" title="View & Manage">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-bar" id="pagination-medium"></div>
                }
                else
                {
                    <div class="empty-state"><div>✨</div><p class="mb-0">No medium priority requests.</p></div>
                }
            </div>
        </div>
    </div>

    <!-- LOW PRIORITY SECTION -->
    <div class="card priority-section priority-low border-0">
        <div class="priority-header text-white" data-bs-toggle="collapse" data-bs-target="#lowSection">
            <div class="d-flex justify-content-between align-items-center">
                <h3>🟢 Low Priority</h3>
                <div class="d-flex align-items-center gap-3">
                    <span class="section-count bg-white text-success">@Model.LowPriorityRequests.Count</span>
                    <span class="collapse-indicator collapsed">▼</span>
                </div>
            </div>
        </div>
        <div id="lowSection" class="collapse">
            <div class="card-body">
                @if (Model.LowPriorityRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Submitted By</th>
                                    <th>Assigned To</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody data-section="low">
                                @foreach (var item in Model.LowPriorityRequests)
                                {
                                    var createdByName = item.createdBy != null ? $"{item.createdBy.fName} {item.createdBy.lName}".Trim() : "Unknown";
                                    var assignedToName = item.assignedTo != null ? $"{item.assignedTo.fName} {item.assignedTo.lName}".Trim() : null;
                                    <tr class="queue-row">
                                        <td><span class="request-id">#@item.requestID</span></td>
                                        <td><strong>@item.title</strong></td>
                                        <td>@item.category?.categoryName</td>
                                        <td><span class="badge bg-secondary">@item.status?.statusName</span></td>
                                        <td>@createdByName</td>
                                        <td>
                                            @if (assignedToName != null)
                                            {
                                                <span class="status-assigned">✓ @assignedToName</span>
                                            }
                                            else
                                            {

                                                <span class="text-muted fw-semibold">⚠️ Unassigned</span>
                                            }
                                        </td>
                                        <td>@item.createdAt.ToString("MM/dd/yy HH:mm")</td>
                                        <td>
                                            <a asp-page="/Manager/ManageRequest" asp-route-id="@item.requestID" class="info-btn" title="View & Manage">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-bar" id="pagination-low"></div>
                }
                else
                {
                    <div class="empty-state"><div>✨</div><p class="mb-0">No low priority requests.</p></div>
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/manager_queue.js"></script>
}
