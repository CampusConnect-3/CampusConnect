@page "{id:int}"
@model CampusConnect.Pages.Manager.ManageRequestModel

@{
    ViewData["Title"] = "Manage Request";

    var createdByName = Model.RequestItem.createdBy != null
        ? $"{Model.RequestItem.createdBy.fName} {Model.RequestItem.createdBy.lName}".Trim()
        : "Unknown";
}

<h1>Manage Request</h1>

<form method="post">
    <div class="row">
        <div class="col-md-5 mb-3">
            <label class="form-label">Assign Technician</label>
            <select asp-for="AssignedTo" class="form-control" asp-items="Model.StaffOptions">
                <option value="">-- Unassigned --</option>
            </select>
        </div>

        <div class="col-md-3 mb-3">
            <label class="form-label">Priority</label>
            <select asp-for="Priority" class="form-control">
                @foreach (var p in Model.PriorityOptions)
                {
                    <option value="@p" selected="@(p == Model.Priority)">
                        @p
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3 mb-3">
            <label class="form-label">Status</label>
            <select asp-for="StatusId" class="form-control" asp-items="Model.StatusOptions"></select>
        </div>

        <div class="col-md-3 mb-3">
            <label class="form-label">Assignment Date</label>
            <input asp-for="AssignedDate" type="date" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="/Manager/Queue" class="btn btn-secondary">Back</a>
</form>