@page
@model CampusConnect.Pages.Manager.ArchiveModel

@{
    ViewData["Title"] = "Archive";
}

<style>
    .info-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 3px solid #1d4ed8;
        background: #fff;
        color: #1d4ed8;
        font-size: 24px;
        font-weight: 700;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
    }

        .info-btn:hover {
            background: #eff6ff;
            text-decoration: none;
            color: #1d4ed8;
        }
</style>

<h1>Archived Requests</h1>

<p>All completed (closed) requests.</p>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-5">
        <label asp-for="SearchTerm" class="form-label">Search</label>
        <input asp-for="SearchTerm"
               class="form-control"
               placeholder="Search title, creator, assigned user, category..." />
    </div>

    <div class="col-md-2">
        <label asp-for="DateFrom" class="form-label">Closed From</label>
        <input asp-for="DateFrom" type="date" class="form-control" />
    </div>

    <div class="col-md-2">
        <label asp-for="DateTo" class="form-label">Closed To</label>
        <input asp-for="DateTo" type="date" class="form-control" />
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-page="./Archive" class="btn btn-secondary">Reset</a>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Ticket ID</th>
            <th>Title of Request</th>
            <th>Created By</th>
            <th>Assigned To</th>
            <th>Info</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.ClosedRequests.Any())
        {
            @foreach (var item in Model.ClosedRequests)
            {
                var createdByName = item.createdBy != null
                ? $"{item.createdBy.fName} {item.createdBy.lName}".Trim()
                : "Unknown";

                var assignedToName = item.assignedTo != null
                ? $"{item.assignedTo.fName} {item.assignedTo.lName}".Trim()
                : "Unassigned";

                <tr>
                    <td>@item.requestID</td>
                    <td>@item.title</td>
                    <td>@createdByName</td>
                    <td>@assignedToName</td>
                    <td>
                        <a asp-page="/Manager/ArchiveExport"
                           asp-route-id="@item.requestID"
                           class="info-btn"
                           title="Archived Request Info">
                            i
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No archived requests found.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-page="./Archive"
       asp-page-handler="ExportCsv"
       asp-route-SearchTerm="@Model.SearchTerm"
       asp-route-DateFrom="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
       asp-route-DateTo="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
       class="btn btn-primary">
        Export All to CSV
    </a>
</div>