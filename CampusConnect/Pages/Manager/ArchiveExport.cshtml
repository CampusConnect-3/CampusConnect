@page "{id:int}"
@model CampusConnect.Pages.Manager.ArchiveExportModel

@{
    ViewData["Title"] = "Archived Request Details";

    var createdByName = Model.RequestItem.createdBy != null
        ? $"{Model.RequestItem.createdBy.fName} {Model.RequestItem.createdBy.lName}".Trim()
        : "Unknown";

    var assignedToName = Model.RequestItem.assignedTo != null
        ? $"{Model.RequestItem.assignedTo.fName} {Model.RequestItem.assignedTo.lName}".Trim()
        : "Unassigned";
}

<h1>Archived Request Details</h1>

<hr />

<div class="mb-4">
    <p><strong>Ticket Number:</strong> @Model.RequestItem.requestID</p>
    <p><strong>Title of Request:</strong> @Model.RequestItem.title</p>
    <p><strong>Description:</strong> @Model.RequestItem.description</p>
    <p><strong>Created By:</strong> @createdByName</p>
    <p><strong>Assigned To:</strong> @assignedToName</p>
    <p><strong>Category:</strong> @Model.RequestItem.category?.categoryName</p>
    <p><strong>Priority:</strong> @Model.RequestItem.priority</p>
    <p><strong>Status:</strong> @Model.RequestItem.status?.statusName</p>
    <p><strong>Building:</strong> @Model.RequestItem.buildingName</p>
    <p><strong>Room Number:</strong> @Model.RequestItem.roomNumber</p>
    <p><strong>Phone Number:</strong> @Model.RequestItem.phoneNumber</p>
    <p><strong>Email:</strong> @Model.RequestItem.email</p>
    <p><strong>Created At:</strong> @Model.RequestItem.createdAt.ToString("MM/dd/yyyy")</p>
    <p><strong>Closed At:</strong> @Model.RequestItem.closedAt?.ToString("MM/dd/yyyy")</p>
</div>

<div class="mt-4">
    <a asp-page="./ArchiveExport"
       asp-page-handler="ExportPdf"
       asp-route-id="@Model.RequestItem.requestID"
       class="btn btn-primary">
        Export PDF Report
    </a>

    <a asp-page="/Manager/Archive" class="btn btn-secondary">
        Back to Archive
    </a>
</div>