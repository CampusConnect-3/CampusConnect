@page
@model CampusConnect.Pages.Manager.IndexModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<h1>Manager Dashboard</h1>

<hr />

<div class="row mb-4">
    <div class="col">
        <h4>Open</h4>
        <h2>@Model.OpenCount</h2>
    </div>
    <div class="col">
        <h4>In Progress</h4>
        <h2>@Model.InProgressCount</h2>
    </div>
    <div class="col">
        <h4>Closed</h4>
        <h2>@Model.ClosedCount</h2>
    </div>
</div>

<hr />

<h4>Recent Requests</h4>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Created By</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.RecentRequests)
        {
            <tr>
                <td>@r.requestID</td>
                <td>@r.title</td>
                <td>@r.createdBy?.email</td>
                <td>@r.status?.statusName</td>
                <td>
                    <a asp-page="/RequestPages/Details" asp-route-id="@r.requestID">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<div>
    <a asp-page="/Manager/Queue" class="btn btn-primary">View Request Queue</a>
    <a asp-page="/Manager/ReviewRequests" class="btn btn-warning">Review Requests</a>
    <a asp-page="/Manager/Archive" class="btn btn-dark">View Archive</a>
</div>