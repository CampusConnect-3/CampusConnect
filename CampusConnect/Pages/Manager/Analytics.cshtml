@page
@model CampusConnect.Pages.Manager.AnalyticsModel
@{
    ViewData["Title"] = "Analytics Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5"><i class="bi bi-graph-up"></i> Analytics Dashboard</h1>

        <!-- Date Range Filter -->
        <form method="get" class="d-flex gap-2">
            <input type="date" name="StartDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
            <input type="date" name="EndDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <a asp-page="/Manager/Analytics" class="btn btn-outline-secondary">Reset</a>
        </form>
    </div>

    <p class="text-muted">
        Showing data from <strong>@Model.DashboardData.StartDate.ToString("MMM dd, yyyy")</strong> to 
        <strong>@Model.DashboardData.EndDate.ToString("MMM dd, yyyy")</strong>
    </p>

    <!-- Key Metrics Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-center border-primary">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Requests</h6>
                    <h2 class="card-title text-primary">@Model.DashboardData.TotalRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-warning">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Pending</h6>
                    <h2 class="card-title text-warning">@Model.DashboardData.PendingRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-info">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">In Progress</h6>
                    <h2 class="card-title text-info">@Model.DashboardData.InProgressRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-success">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Completed</h6>
                    <h2 class="card-title text-success">@Model.DashboardData.CompletedRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-danger">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Cancelled</h6>
                    <h2 class="card-title text-danger">@Model.DashboardData.CancelledRequests</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-center border-secondary">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Avg. Resolution</h6>
                    <h2 class="card-title text-secondary">@Model.DashboardData.AverageResolutionTimeHours.ToString("F1")h</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> Daily Request Trend</h5>
                </div>
                <div class="card-body">
                    <canvas id="dailyTrendChart" height="80"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Requests by Status</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-tags"></i> Requests by Category</h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryChart" height="80"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Requests by Priority</h5>
                </div>
                <div class="card-body">
                    <canvas id="priorityChart" height="80"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Requesters Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Top 10 Requesters</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Name</th>
                                <th>Total Requests</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rank = 1;
                            }
                            @foreach (var requester in Model.DashboardData.TopRequesters)
                            {
                                var percentage = Model.DashboardData.TotalRequests > 0 
                                    ? (requester.Value * 100.0 / Model.DashboardData.TotalRequests).ToString("F1") 
                                    : "0.0";
                                <tr>
                                    <td><strong>@rank</strong></td>
                                    <td>@requester.Key</td>
                                    <td>@requester.Value</td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar bg-primary" role="progressbar" 
                                                 style="width: @percentage%" 
                                                 aria-valuenow="@requester.Value" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="@Model.DashboardData.TotalRequests">
                                                @percentage%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Daily Trend Line Chart
        const dailyTrendCtx = document.getElementById('dailyTrendChart').getContext('2d');
        new Chart(dailyTrendCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.DailyRequestTrend.Select(x => x.Key))),
                datasets: [{
                    label: 'Requests',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.DailyRequestTrend.Select(x => x.Value))),
                    borderColor: 'rgb(13, 110, 253)',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });

        // Status Pie Chart
        const statusPieCtx = document.getElementById('statusPieChart').getContext('2d');
        new Chart(statusPieCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.RequestsByStatus.Select(x => x.Key))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.RequestsByStatus.Select(x => x.Value))),
                    backgroundColor: [
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(13, 202, 240, 0.8)',
                        'rgba(25, 135, 84, 0.8)',
                        'rgba(220, 53, 69, 0.8)'
                    ]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Category Bar Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        new Chart(categoryCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.RequestsByCategory.Select(x => x.Key))),
                datasets: [{
                    label: 'Requests',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.RequestsByCategory.Select(x => x.Value))),
                    backgroundColor: 'rgba(13, 202, 240, 0.7)',
                    borderColor: 'rgba(13, 202, 240, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });

        // Priority Bar Chart
        const priorityCtx = document.getElementById('priorityChart').getContext('2d');
        new Chart(priorityCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.RequestsByPriority.Select(x => x.Key))),
                datasets: [{
                    label: 'Requests',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.RequestsByPriority.Select(x => x.Value))),
                    backgroundColor: [
                        'rgba(220, 53, 69, 0.7)',
                        'rgba(255, 193, 7, 0.7)',
                        'rgba(13, 202, 240, 0.7)',
                        'rgba(108, 117, 125, 0.7)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });
    </script>
}