@page
@model CampusConnect.Pages.Manager.AIInsights.DetailsModel

@{
    ViewData["Title"] = "Insight Details";
    var severityClass = Model.Insight.Severity switch
    {
        "Critical" => "danger",
        "Warning" => "warning",
        _ => "primary"
    };
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">AI Insights</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>

    <div class="card border-@severityClass border-3 mb-4">
        <div class="card-header bg-@severityClass text-white">
            <h3 class="mb-0">@Model.Insight.Title</h3>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Severity:</strong> <span class="badge bg-@severityClass">@Model.Insight.Severity</span>
                </div>
                <div class="col-md-6">
                    <strong>Type:</strong> @Model.Insight.InsightType
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Insight.BuildingName))
            {
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Building:</strong> @Model.Insight.BuildingName
                    </div>
                    <div class="col-md-6">
                        <strong>Category:</strong> @Model.Insight.CategoryName
                    </div>
                </div>
            }

            <div class="row mb-3">
                <div class="col-12">
                    <strong>Generated:</strong> @Model.Insight.GeneratedAt.ToString("MMMM dd, yyyy HH:mm")
                    <small class="text-muted ms-2">by @Model.Insight.AIModel</small>
                </div>
            </div>

            <hr />

            <h5>📊 Metrics</h5>
            <ul>
                <li><strong>Request Count:</strong> @Model.Insight.Metrics.RequestCount</li>
                <li><strong>Time Period:</strong> @Model.Insight.Metrics.DaySpan days</li>
                <li><strong>Increase:</strong> @Model.Insight.Metrics.IncreasePercentage.ToString("F1")%</li>
            </ul>

            <h5>📝 Analysis</h5>
            <p class="lead">@Model.Insight.Description</p>

            <h5>💡 Recommendation</h5>
            <div class="alert alert-info">
                @Model.Insight.Recommendation
            </div>

            @if (Model.Insight.AcknowledgedAt.HasValue)
            {
                <div class="alert alert-success">
                    ✓ Acknowledged by @Model.Insight.AcknowledgedBy on @Model.Insight.AcknowledgedAt.Value.ToString("MMM dd, yyyy")
                </div>
            }

            @if (Model.Insight.ResolvedAt.HasValue)
            {
                <div class="alert alert-success">
                    <strong>✓ Resolved</strong> on @Model.Insight.ResolvedAt.Value.ToString("MMM dd, yyyy")
                    @if (!string.IsNullOrEmpty(Model.Insight.ResolutionNotes))
                    {
                        <p class="mb-0 mt-2"><strong>Notes:</strong> @Model.Insight.ResolutionNotes</p>
                    }
                </div>
            }
        </div>
        <div class="card-footer">
            @if (!Model.Insight.AcknowledgedAt.HasValue)
            {
                <form method="post" asp-page-handler="Acknowledge" asp-route-id="@Model.Insight.Id" class="d-inline">
                    <button type="submit" class="btn btn-primary">Mark as Acknowledged</button>
                </form>
            }

            @if (!Model.Insight.ResolvedAt.HasValue)
            {
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#resolveModal">
                    Mark as Resolved
                </button>
            }

            <a asp-page="./Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    <!-- Related Requests -->
    @if (Model.RelatedRequests.Any())
    {
        <h4>📋 Related Requests (@Model.RelatedRequests.Count)</h4>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.RelatedRequests)
                    {
                        <tr>
                            <td>#@request.requestID</td>
                            <td>@request.title</td>
                            <td><span class="badge bg-secondary">@request.priority</span></td>
                            <td>@request.status?.statusName</td>
                            <td>@request.createdAt.ToString("MM/dd/yy")</td>
                            <td>
                                <a asp-page="/Manager/ManageRequest" asp-route-id="@request.requestID" class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Resolve" asp-route-id="@Model.Insight.Id">
                <div class="modal-header">
                    <h5 class="modal-title">Resolve Insight</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Resolution Notes (Optional)</label>
                    <textarea name="resolutionNotes" class="form-control" rows="3" placeholder="Describe actions taken..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Mark as Resolved</button>
                </div>
            </form>
        </div>
    </div>
</div>