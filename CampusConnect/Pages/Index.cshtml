@page
@model CampusConnect.Pages.IndexModel

<link rel="stylesheet" href="~/css/student_index.css" />

<div class="home-shell">

    <!-- Welcome Header -->
    <div class="welcome-section">
        <h1 class="welcome-title">Welcome, @Model.DisplayName</h1>
        <p class="welcome-sub">Student ID: @Model.StudentId</p>
    </div>

    <!-- Action Buttons -->
    <div class="hero-actions">
        <a class="btn-submit" asp-page="/RequestPages/Create">
            <i class="bi bi-plus-circle"></i> Submit New Request
        </a>
   
    </div>

    <!-- Stat Cards -->
    <div class="stat-grid">
        <div class="stat-card blue">
            <div class="stat-label">Open Requests</div>
            <div class="stat-value">@Model.OpenCount</div>
        </div>
        <div class="stat-card amber">
            <div class="stat-label">In Progress</div>
            <div class="stat-value">@Model.InProgressCount</div>
        </div>
        <div class="stat-card green">
            <div class="stat-label">Closed Requests</div>
            <div class="stat-value">@Model.ClosedCount</div>
        </div>
    </div>

    <!-- Recent Requests Table -->
    <div class="table-card">
        <div class="table-title">Recent Requests</div>
        <table class="table table-borderless" id="recent-table">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Last Updated</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentRequests != null && Model.RecentRequests.Any())
                {
                    foreach (var r in Model.RecentRequests)
                    {
                        var statusClass = (r.status?.statusName?.ToLower().Replace(" ", "")) switch
                        {
                            "todo" => "status-todo",
                            "inprogress" => "status-inprogress",
                            "closed" => "status-closed",
                            _ => "status-todo"
                        };

                        <tr class="recent-row">
                            <td class="ticket-id">
                                <a asp-page="/RequestPages/Details" asp-route-id="@r.requestID"
                                   class="ticket-link">@r.requestID</a>
                            </td>
                            <td class="ticket-title">@r.title</td>
                            <td><span class="badge-pill @statusClass">@(r.status?.statusName ?? "N/A")</span></td>
                            <td class="ticket-date">@r.createdAt.ToString("MM/dd/yyyy")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No requests yet.</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-bar" id="pagination-recent"></div>
    </div>

</div>

@section Scripts {
    <script src="~/js/student_index.js"></script>
}
