@page
@model CampusConnect.Pages.Admin.UserPages.IndexModel
@{
    ViewData["Title"] = "User Management";
}

<link rel="stylesheet" href="~/css/admin_index.css" />

<div class="um-header">
    <div>
        <h1>User Management</h1>
        <p>Manage all registered users, roles, and account statuses.</p>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card blue">
        <div class="stat-label">Total Users</div>
        <div class="stat-value">@Model.TotalUsers</div>
    </div>
    <div class="stat-card green">
        <div class="stat-label">Active Users</div>
        <div class="stat-value">@Model.ActiveUsers</div>
    </div>
    <div class="stat-card amber">
        <div class="stat-label">Pending Users</div>
        <div class="stat-value">@Model.PendingUsers</div>
    </div>
    <div class="stat-card purple">
        <div class="stat-label">Staff / Managers</div>
        <div class="stat-value">@Model.StaffAndManagers</div>
    </div>
</div>

<!-- Search Card -->
<div class="search-card">
    <form method="get" class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Search</label>
            <input asp-for="SearchTerm" class="form-control"
                   placeholder="Search by name, username, email, role, or status..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Filter by Role</label>
            <select asp-for="RoleFilter" class="form-select">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="Staff">Staff</option>
                <option value="User">User</option>
                <option value="Pending">Pending</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label invisible">Actions</label>
            <div class="d-flex gap-3 justify-content-end">
                <button type="submit" class="btn-search">Search</button>
                <a asp-page="./Index" class="btn-reset">Reset</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.RoleFilter))
    {
        <div class="mt-3 d-flex align-items-center gap-2 flex-wrap">
            <span class="filter-label">Active filters:</span>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <span class="active-filter-tag">
                    Search: "@Model.SearchTerm"
                    <a asp-page="./Index" asp-route-RoleFilter="@Model.RoleFilter">✕</a>
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RoleFilter))
            {
                <span class="active-filter-tag">
                    Role: @Model.RoleFilter
                    <a asp-page="./Index" asp-route-SearchTerm="@Model.SearchTerm">✕</a>
                </span>
            }
        </div>
    }
</div>

<!-- Table Card -->
<div class="table-card">
    <div class="table-meta">Showing @Model.Users.Count users</div>
    <table class="table table-borderless" id="user-table">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Info</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users == null || !Model.Users.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No users found.</td>
                </tr>
            }
            else
            {
                foreach (var u in Model.Users)
                {
                    var roleClass = (u.RoleName?.ToLower()) switch
                    {
                        "admin" => "role-admin",
                        "manager" => "role-manager",
                        "staff" => "role-staff",
                        "user" => "role-user",
                        _ => "role-other"
                    };

                    <tr class="user-row">
                        <td class="user-name">@(string.IsNullOrWhiteSpace(u.FullName) ? "(no profile)" : u.FullName)</td>
                        <td class="user-secondary">@u.UserName</td>
                        <td class="user-secondary">@u.Email</td>
                        <td><span class="role-pill @roleClass">@u.RoleName</span></td>
                        <td>
                            @if (u.Status?.ToLowerInvariant().Contains("pending") == true)
                            {
                                <span class="badge-pill status-pending">Pending</span>
                            }
                            else if (u.Status?.ToLowerInvariant().Contains("active") == true)
                            {
                                <span class="badge-pill status-active">Active</span>
                            }
                            else
                            {
                                <span class="badge-pill status-other">@u.Status</span>
                            }
                        </td>
                        <td>
                            @if (u.AppUserId.HasValue)
                            {
                                <a asp-page="./Details"
                                   asp-route-id="@u.AppUserId"
                                   class="info-btn"
                                   title="User Info">i</a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination-bar" id="pagination-users"></div>
</div>

@section Scripts {
    <script src="~/js/admin_index.js"></script>
}
