@page
@model CampusConnect.Pages.Admin.UserPages.IndexModel

@{
    ViewData["Title"] = "User Management";
}

<style>
    .page-shell {
        max-width: 1200px;
        margin: 18px auto;
        padding: 18px;
    }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .page-title {
        font-size: 24px;
        font-weight: 700;
        margin: 0;
    }

    .btn-simple {
        display: inline-block;
        background: #0b5ed7;
        color: #fff !important;
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .summary-card {
        border: 2px solid #111;
        background: #fff;
        padding: 14px;
    }

    .summary-label {
        font-size: 13px;
        color: #555;
        margin-bottom: 8px;
    }

    .summary-value {
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
    }

    .card-box {
        border: 2px solid #111;
        background: #fff;
        padding: 14px;
    }

    .search-row {
        margin-bottom: 14px;
    }

    table.user-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        table.user-table th {
            text-align: left;
            padding: 10px 8px;
            border-bottom: 2px solid #111;
            white-space: nowrap;
        }

        table.user-table td {
            padding: 12px 8px;
            border-top: 1px solid #ddd;
            vertical-align: middle;
        }

    .muted {
        color: #666;
        font-size: 12px;
    }

    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 12px;
        line-height: 1;
    }

    .badge-active {
        background: #198754;
        color: #fff;
    }

    .badge-pending {
        background: #f0ad4e;
        color: #111;
    }

    .badge-other {
        background: #6c757d;
        color: #fff;
    }

    .role-text {
        font-weight: 600;
    }

    .info-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 3px solid #1d4ed8;
        background: #fff;
        color: #1d4ed8;
        font-size: 24px;
        font-weight: 700;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        text-decoration: none;
    }

        .info-btn:hover {
            background: #eff6ff;
            text-decoration: none;
            color: #1d4ed8;
        }
</style>

<div class="page-shell">
    <div class="topbar">
        <h1 class="page-title">User Management</h1>
        <a class="btn-simple" asp-page="./Create">+ Create User</a>
    </div>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-label">Total Users</div>
            <div class="summary-value">@Model.TotalUsers</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Active Users</div>
            <div class="summary-value">@Model.ActiveUsers</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Pending Users</div>
            <div class="summary-value">@Model.PendingUsers</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Staff / Managers</div>
            <div class="summary-value">@Model.StaffAndManagers</div>
        </div>
    </div>

    <div class="card-box">
        <form method="get" class="search-row">
            <div class="row g-2">
                <div class="col-md-5">
                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Search by name, username, email, role, or status..." />
                </div>
                <div class="col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a asp-page="./Index" class="btn btn-secondary">Reset</a>
                </div>
            </div>
        </form>

        <div class="muted" style="margin-bottom:10px;">
            Showing @Model.Users.Count users
        </div>

        <table class="user-table">
            <thead>
                <tr>
                    <th style="width:20%;">Full Name</th>
                    <th style="width:16%;">Username</th>
                    <th style="width:26%;">Email</th>
                    <th style="width:16%;">Role</th>
                    <th style="width:12%;">Status</th>
                    <th style="width:10%;">Info</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users == null || !Model.Users.Any())
                {
                    <tr>
                        <td colspan="6" class="muted" style="padding:20px; text-align:center;">
                            No users found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>@(string.IsNullOrWhiteSpace(u.FullName) ? "(no profile)" : u.FullName)</td>
                            <td>@u.UserName</td>
                            <td>@u.Email</td>
                            <td class="role-text">@u.RoleName</td>
                            <td>
                                @if (u.Status?.ToLowerInvariant().Contains("pending") == true)
                                {
                                    <span class="badge badge-pending">Pending</span>
                                }
                                else if (u.Status?.ToLowerInvariant().Contains("active") == true)
                                {
                                    <span class="badge badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-other">@u.Status</span>
                                }
                            </td>
                            <td>
                                @if (u.AppUserId.HasValue)
                                {
                                    <a asp-page="./Details"
                                       asp-route-id="@u.AppUserId"
                                       class="info-btn"
                                       title="User Info">
                                        i
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>