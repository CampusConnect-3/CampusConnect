@page
@model CampusConnect.Pages.Admin.UserPages.DetailsModel

@{
    ViewData["Title"] = "User Overview";
}

<style>
    .page-shell {
        max-width: 900px;
        margin: 20px auto;
        padding: 20px;
    }

    .card-box {
        border: 2px solid #111;
        padding: 20px;
        background: #fff;
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 12px;
        border-bottom: 2px solid #111;
        padding-bottom: 6px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px 24px;
    }

    .info-box {
        border: 1px solid #ccc;
        padding: 12px;
        background: #fafafa;
    }

    .label {
        font-size: 12px;
        font-weight: 700;
        color: #555;
        margin-bottom: 4px;
        text-transform: uppercase;
    }

    .actions {
        margin-top: 20px;
        display: flex;
        gap: 10px;
    }

    .badge-active {
        background: #198754;
        color: #fff;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .badge-pending {
        background: #f0ad4e;
        color: #111;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }
</style>

<div class="page-shell">
    <h1>User Overview</h1>

    <div class="card-box">

        <div class="section-title">User Information</div>

        <div class="info-grid">
            <div class="info-box">
                <div class="label">Full Name</div>
                <div>@Model.user.fName @Model.user.lName</div>
            </div>

            <div class="info-box">
                <div class="label">Username</div>
                <div>@Model.user.username</div>
            </div>

            <div class="info-box">
                <div class="label">Email</div>
                <div>@Model.user.email</div>
            </div>

            <div class="info-box">
                <div class="label">Role</div>
                <div>@Model.RoleName</div>
            </div>

            <div class="info-box">
                <div class="label">Department</div>
                <div>@Model.user.department</div>
            </div>

            <div class="info-box">
                <div class="label">Status</div>
                <div>
                    @if (Model.user.status?.ToLower().Contains("active") == true)
                    {
                        <span class="badge-active">Active</span>
                    }
                    else if (Model.user.status?.ToLower().Contains("pending") == true)
                    {
                        <span class="badge-pending">Pending</span>
                    }
                    else
                    {
                        @Model.user.status
                    }
                </div>
            </div>
        </div>

        <div class="section-title mt-4">Account Type</div>

        <div class="info-box">
            @(string.IsNullOrWhiteSpace(Model.user.identityUserId)
                        ? "Legacy local (no Identity account)"
                        : "Identity account")
        </div>

        <div class="actions">
            <a asp-page="./Edit" asp-route-id="@Model.user.userID" class="btn btn-primary">
                Edit
            </a>

            <a asp-page="./ManageRoles" asp-route-identityUserId="@Model.user.identityUserId" class="btn btn-warning">
                Manage Roles
            </a>

            <a asp-page="./Delete" asp-route-id="@Model.user.userID" class="btn btn-danger">
                Delete
            </a>

            <a asp-page="./Index" class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>
</div>