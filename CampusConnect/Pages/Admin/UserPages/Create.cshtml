@page
@model CampusConnect.Pages.Admin.UserPages.CreateModel
@{
    ViewData["Title"] = "Create User";
}

<link rel="stylesheet" href="~/css/admin_create.css" />

<div class="create-header">
    <h1>Create User</h1>
    <p>Create an Identity login and optional app profile.</p>
</div>

<div class="create-card">

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <div class="section-label">Account Info</div>
        <div class="field-grid">
            <div class="field">
                <label asp-for="Input.Email" class="field-label"></label>
                <input asp-for="Input.Email" type="email" class="field-input" placeholder="e.g. user@campusconnect.com" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Role" class="field-label"></label>
                <select asp-for="Input.Role" asp-items="Model.RoleOptions" class="field-input"></select>
                <span asp-validation-for="Input.Role" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password" class="field-label"></label>
                <input asp-for="Input.Password" type="password" class="field-input" placeholder="Min. 8 characters" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword" class="field-label"></label>
                <input asp-for="Input.ConfirmPassword" type="password" class="field-input" placeholder="Re-enter password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>
        </div>

        <div class="field-divider"></div>

        <div class="section-label">Profile Info</div>
        <div class="field-grid">
            <div class="field">
                <label asp-for="Input.FirstName" class="field-label"></label>
                <input asp-for="Input.FirstName" class="field-input" placeholder="First name" />
                <span asp-validation-for="Input.FirstName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.LastName" class="field-label"></label>
                <input asp-for="Input.LastName" class="field-input" placeholder="Last name" />
                <span asp-validation-for="Input.LastName" class="field-error"></span>
            </div>
            <div class="field field-full">
                <label asp-for="Input.Department" class="field-label"></label>
                <input asp-for="Input.Department" class="field-input" placeholder="e.g. Facilities, IT, Administration" />
                <span asp-validation-for="Input.Department" class="field-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-page="./Index" class="btn-cancel">Cancel</a>
            <button type="submit" class="btn-create">Create User</button>
        </div>
    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
