@page
@model CampusConnect.Pages.Admin.TestMongoModel
@{
    ViewData["Title"] = "Test MongoDB";
}

<h1>MongoDB Test Dashboard</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Request Snapshots</h5>
                <p class="card-text display-4">@Model.SyncedCount</p>
                <p class="text-muted">Requests synced to MongoDB</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">AI Insights</h5>
                <p class="card-text display-4">@Model.InsightCount</p>
                <p class="text-muted">Generated insights</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Activity Logs</h5>
                <p class="card-text display-4">@Model.ActivityLogCount</p>
                <p class="text-muted">Logged activities</p>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.DebugInfo))
{
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">📊 Pattern Detection Status</h5>
        </div>
        <div class="card-body">
            <pre class="mb-0">@Model.DebugInfo</pre>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-md-12">
        <h3>Actions</h3>
        <div class="d-flex gap-2 flex-wrap">
            <form method="post" asp-page-handler="SeedTestData">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-database-add"></i> 1. Seed Test Data
                </button>
            </form>
            
            <form method="post" asp-page-handler="SyncAll">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-arrow-repeat"></i> 2. Sync All Requests
                </button>
            </form>
            
            <form method="post" asp-page-handler="GenerateInsights">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-lightbulb"></i> 3. Generate AI Insights
                </button>
            </form>
        </div>
        
        <div class="alert alert-info mt-3">
            <strong>📋 Workflow:</strong>
            <ol class="mb-0">
                <li><strong>Seed Test Data</strong> - Creates 15 pattern-based requests from sarabrown@school.edu
                    <ul>
                        <li>6 HVAC issues in Science Building</li>
                        <li>5 Network issues in Library</li>
                        <li>4 Plumbing issues in Student Center</li>
                    </ul>
                </li>
                <li><strong>Sync All Requests</strong> - ⚠️ IMPORTANT: Copies SQL requests to MongoDB (required for AI analysis)</li>
                <li><strong>Generate AI Insights</strong> - Analyzes MongoDB patterns with Gemini AI</li>
            </ol>
            <hr />
            <p class="mb-0"><strong>Requirements for AI Insights:</strong></p>
            <ul class="mb-0">
                <li>Building must have <strong>5+ requests</strong> in last 30 days</li>
                <li>Same category must have <strong>3+ requests</strong> within that building</li>
                <li>Requests must be <strong>synced to MongoDB</strong> first</li>
            </ul>
        </div>
    </div>
</div>