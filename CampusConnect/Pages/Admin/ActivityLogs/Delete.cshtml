@page
@model CampusConnect.Pages.Admin.ActivityLogs.DeleteModel
@{
    ViewData["Title"] = "Delete Activity Log";
}

<div class="container mt-4">
    <h1 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Activity Log</h1>

    <div class="alert alert-danger mt-4">
        <h5>Are you sure you want to delete this activity log?</h5>
        <p>This action cannot be undone.</p>
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5>Activity Log Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Timestamp</dt>
                <dd class="col-sm-9">@Model.ActivityLog.Timestamp.ToLocalTime().ToString("MMMM dd, yyyy hh:mm:ss tt")</dd>

                <dt class="col-sm-3">User</dt>
                <dd class="col-sm-9">
                    <strong>@Model.ActivityLog.UserName</strong><br />
                    <small class="text-muted">@Model.ActivityLog.UserRole</small>
                </dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info">@Model.ActivityLog.Action.Replace("_", " ")</span>
                </dd>

                @if (Model.ActivityLog.RequestId.HasValue)
                {
                    <dt class="col-sm-3">Request</dt>
                    <dd class="col-sm-9">#@Model.ActivityLog.RequestId - @Model.ActivityLog.RequestTitle</dd>
                }

                @if (!string.IsNullOrEmpty(Model.ActivityLog.IpAddress))
                {
                    <dt class="col-sm-3">IP Address</dt>
                    <dd class="col-sm-9"><code>@Model.ActivityLog.IpAddress</code></dd>
                }

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.ActivityLog.Reviewed)
                    {
                        <span class="badge bg-success">Reviewed</span>
                        <br />
                        <small>Reviewed by: @Model.ActivityLog.ReviewedBy</small>
                    }
                    else
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <form method="post" class="mt-4">
        <input type="hidden" asp-for="ActivityLog.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete
            </button>
            <a asp-page="./Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
        </div>
    </form>
</div>