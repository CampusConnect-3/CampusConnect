@page "{id:int}"
@model CampusConnect.Pages.RequestPages.ConversationModel

@{
    ViewData["Title"] = "Request Conversation";
}

<style>
    .conversation-shell {
        max-width: 980px;
        margin: 18px auto;
        padding: 18px;
    }

    .conversation-card {
        border: 4px solid #000;
        background: #fff;
        padding: 18px;
    }

    .breadcrumb {
        color: #666;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .conversation-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 18px;
        padding-bottom: 14px;
        border-bottom: 3px solid #111;
    }

    .conversation-title {
        margin: 0 0 6px 0;
        font-size: 28px;
    }

    .conversation-subtitle {
        color: #555;
    }

    .pill {
        display: inline-block;
        padding: 6px 12px;
        border: 2px solid #111;
        font-weight: 700;
        font-size: 13px;
        background: #f4f4f4;
        white-space: nowrap;
    }

    .conversation-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .btn {
        display: inline-block;
        padding: 10px 14px;
        border: 2px solid #111;
        text-decoration: none;
        font-weight: 700;
        background: #fff;
        color: #111;
    }

    .btn-primary {
        background: #0b5ed7;
        border-color: #0b5ed7;
        color: #fff;
    }

    .history-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 14px;
    }

    .history-panel {
        max-height: 360px;
        overflow-y: auto;
        padding-right: 6px;
        margin-bottom: 6px;
    }

    .history-item {
        display: flex;
    }

    .history-item.requester {
        justify-content: flex-start;
    }

    .history-item.staff {
        justify-content: flex-end;
    }

    .history-bubble {
        border: 1px solid #d8d8d8;
        background: #fafafa;
        padding: 14px 16px;
        width: min(100%, 640px);
    }

    .history-item.requester .history-bubble {
        background: #f7f7f7;
        border-color: #d7d7d7;
    }

    .history-item.staff .history-bubble {
        background: #eef5ff;
        border-color: #bcd0ef;
    }

    .history-meta {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
        color: #666;
        font-size: 12px;
    }

    .history-author {
        font-weight: 700;
        color: #111;
    }

    .history-text {
        white-space: pre-wrap;
        color: #111;
    }

    .reply-box {
        margin-top: 20px;
        border-top: 3px solid #111;
        padding-top: 16px;
    }

    .reply-box label {
        display: block;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .reply-box textarea {
        width: 100%;
        min-height: 72px;
        padding: 12px;
        border: 1px solid #ccc;
        font: inherit;
        resize: vertical;
    }

    .validation {
        color: #b42318;
        font-size: 13px;
        margin-top: 6px;
    }

    .is-submitting {
        opacity: 0.7;
        pointer-events: none;
    }

    @@media (max-width: 820px) {
        .conversation-header {
            flex-direction: column;
        }

        .history-meta {
            flex-direction: column;
        }
    }
</style>

<div class="conversation-shell">
    <div class="breadcrumb">
        <a asp-page="/Index">Home</a> /
        <a asp-page="/RequestPages/Details" asp-route-id="@Model.RequestItem.requestID">Request Details</a> /
        Conversation
    </div>

    <div class="conversation-card">
        <div class="conversation-header">
            <div>
                <h1 class="conversation-title">Conversation for Request @Model.RequestItem.requestID.ToString("D5")</h1>
                <div class="conversation-subtitle">
                    @Model.RequestItem.title
                </div>
            </div>

            <span class="pill">
                Status:
                @(Model.RequestItem.status?.statusName ?? "Unknown")
            </span>
        </div>

        <div class="conversation-actions">
            <a class="btn" asp-page="/RequestPages/Details" asp-route-id="@Model.RequestItem.requestID">Back to Ticket</a>
        </div>

        @if (Model.Comments.Any())
        {
            <div class="history-panel">
                <ul class="history-list">
                    @foreach (var comment in Model.Comments)
                    {
                        var sideClass = Model.IsRequesterComment(comment) ? "requester" : "staff";

                        <li class="history-item @sideClass">
                            <div class="history-bubble">
                                <div class="history-meta">
                                    <span>
                                        <span class="history-author">@Model.GetDisplayName(comment.creator)</span>
                                    </span>
                                    <span>@comment.createdAt.ToString("MM/dd/yyyy h:mm tt")</span>
                                </div>
                                <div class="history-text">@comment.commentText</div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <p style="color:#666;">No messages yet. Start the conversation below.</p>
        }

        <div class="reply-box">
            <form method="post" id="conversation-form">
                <label asp-for="Input.CommentText">Add Reply</label>
                <textarea asp-for="Input.CommentText" id="reply-box" placeholder="Write your reply here."></textarea>
                <span asp-validation-for="Input.CommentText" class="validation"></span>
                <div asp-validation-summary="ModelOnly" class="validation"></div>

                <div class="conversation-actions" style="margin-top:12px;">
                    <button type="submit" class="btn btn-primary" id="send-reply-button">Send Reply</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('conversation-form');
            const replyBox = document.getElementById('reply-box');
            const sendButton = document.getElementById('send-reply-button');

            if (!form || !replyBox || !sendButton) {
                return;
            }

            let isSubmitting = false;
            let allowNextSubmit = false;

            function lockForm() {
                if (isSubmitting) {
                    return false;
                }

                const value = replyBox.value.trim();
                if (!value) {
                    return false;
                }

                isSubmitting = true;
                form.classList.add('is-submitting');
                replyBox.readOnly = true;
                sendButton.disabled = true;
                sendButton.textContent = 'Sending...';
                return true;
            }

            function submitReply() {
                if (!lockForm()) {
                    return;
                }

                allowNextSubmit = true;
                form.requestSubmit();
            }

            replyBox.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' && !event.shiftKey) {
                    event.preventDefault();
                    submitReply();
                }
            });

            form.addEventListener('submit', function (event) {
                if (allowNextSubmit) {
                    allowNextSubmit = false;
                    return;
                }

                if (isSubmitting) {
                    event.preventDefault();
                    return;
                }

                if (!lockForm()) {
                    return;
                }
            });
        })();
    </script>
}
