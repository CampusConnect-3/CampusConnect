@page
@model CampusConnect.Pages.RequestPages.CreateModel

@{
    ViewData["Title"] = "Submit New Request";
}

<style>
    .submit-shell {
        max-width: 980px;
        margin: 24px auto;
        padding: 24px;
    }

    .breadcrumb {
        color: #666;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .submit-title {
        font-size: 32px;
        margin-bottom: 8px;
    }

    .submit-desc {
        color: #4d4d4d;
        max-width: 700px;
        margin-bottom: 22px;
    }

    .form-card {
        border: 3px solid #111;
        padding: 24px;
        background: #fff;
        box-shadow: 10px 10px 0 #d8e6f7;
    }

    .form-top {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

        .form-top .person {
            background: #f2f6fb;
            border: 1px solid #c7d8eb;
            padding: 14px 16px;
        }

    .person-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #4b6785;
        margin-bottom: 4px;
    }

    .person-value {
        font-size: 17px;
        font-weight: 600;
        color: #111;
        word-break: break-word;
    }

    .intake-note {
        border: 1px solid #d6e2ef;
        background: linear-gradient(135deg, #f8fbff 0%, #eef5fc 100%);
        padding: 16px 18px;
        margin-bottom: 24px;
    }

    .intake-note strong {
        display: block;
        margin-bottom: 4px;
    }

    .form-sections {
        display: grid;
        gap: 20px;
    }

    .form-section {
        border: 1px solid #d8d8d8;
        padding: 20px;
        background: #fcfcfc;
    }

    .section-heading {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 2px solid #111;
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 18px;
    }

    .field {
        margin-bottom: 16px;
    }

        .field label {
            display: block;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .field input[type="text"],
        .field input[type="email"],
        .field input[type="tel"],
        .field select,
        .field textarea {
            width: 100%;
            padding: 11px 12px;
            background: #fff;
            border: 1px solid #b7c4d1;
            box-sizing: border-box;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .field input:focus,
        .field textarea:focus,
        .field select:focus {
            outline: none;
            border-color: #0b5ed7;
            box-shadow: 0 0 0 3px rgba(11, 94, 215, 0.12);
        }

        .field input[readonly] {
            background: #f3f4f6;
            color: #555;
            cursor: not-allowed;
        }

        .field textarea {
            min-height: 170px;
            resize: vertical;
        }

    .field-wide {
        grid-column: 1 / -1;
    }

    .required-asterisk {
        color: #c00;
        margin-left: 6px;
    }

    .attachments {
        padding: 14px;
        background: #fff;
        border: 1px dashed #8ea7c0;
    }

    .help-text {
        color: #666;
        font-size: 13px;
        margin-top: 6px;
    }

    .submit-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .submit-note {
        color: #555;
        max-width: 520px;
    }

    .btn-submit {
        background: #0b5ed7;
        color: #fff;
        padding: 13px 28px;
        border: 2px solid #0b5ed7;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .submit-shell {
            padding: 16px;
        }

        .form-card {
            padding: 18px;
            box-shadow: none;
        }

        .form-top,
        .field-grid {
            grid-template-columns: 1fr;
        }

        .submit-row {
            align-items: stretch;
        }

        .btn-submit {
            width: 100%;
        }
    }
</style>

<div class="submit-shell">
    <div class="breadcrumb">
        <a asp-page="/Index">Home</a> / Submit Request
    </div>

    <h1 class="submit-title">Submit New Request</h1>
    <div class="submit-desc">
        Please fill out the form below to submit a new service request. Provide as much detail as possible so we can help you faster.
    </div>

    <div class="form-card">
        <div class="form-top">
            <div class="person">
                <span class="person-label">Signed In As</span>
                <div class="person-value">@Model.DisplayName</div>
            </div>
            <div class="person">
                <span class="person-label">Student ID</span>
                <div class="person-value">@Model.StudentId</div>
            </div>
        </div>

        <div class="intake-note">
            <strong>What happens next</strong>
            Your request goes into the intake queue first. Staff will review it, assign the right department, and set the priority after they assess the issue.
        </div>

        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-sections">
                <section class="form-section">
                    <div class="section-heading">Request Details</div>
                    <div class="field-grid">
                        <div class="field field-wide">
                            <label asp-for="request.title">Subject <span class="required-asterisk">*</span></label>
                            <input asp-for="request.title" />
                            <span asp-validation-for="request.title" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label asp-for="request.buildingName">Building <span class="required-asterisk">*</span></label>
                            <input asp-for="request.buildingName" />
                            <span asp-validation-for="request.buildingName" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label asp-for="request.roomNumber">Room <span class="required-asterisk">*</span></label>
                            <input asp-for="request.roomNumber" />
                            <span asp-validation-for="request.roomNumber" class="text-danger"></span>
                        </div>

                        <div class="field field-wide">
                            <label asp-for="request.description">Description <span class="required-asterisk">*</span></label>
                            <textarea asp-for="request.description" placeholder="Describe the problem, when it started, and anything you've already tried."></textarea>
                            <span asp-validation-for="request.description" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="form-section">
                    <div class="section-heading">Contact Details</div>
                    <div class="field-grid">
                        <div class="field">
                            <label asp-for="request.email">Email Address <span class="required-asterisk">*</span></label>
                            <input asp-for="request.email" type="email" readonly />
                            <span asp-validation-for="request.email" class="text-danger"></span>
                        </div>

                        <div class="field">
                            <label asp-for="request.phoneNumber">Phone Number</label>
                            <input asp-for="request.phoneNumber" />
                            <span asp-validation-for="request.phoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </section>

                <section class="form-section">
                    <div class="section-heading">Supporting Files</div>
                    <div class="field">
                        <label>Attachments (png, jpg, pdf)</label>
                        <div class="attachments">
                            <input type="file" name="Attachments" accept=".png,.jpg,.jpeg,.pdf" multiple />
                        </div>
                        <div class="help-text">Optional. Add screenshots or PDFs if needed.</div>
                    </div>
                </section>
            </div>

            <div class="submit-row">
                <div class="submit-note">
                    Required fields are marked with an asterisk. Priority and department are assigned after review.
                </div>
                <button type="submit" class="btn-submit">Submit Request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
