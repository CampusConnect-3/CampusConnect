@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Collections.Generic
@using System.Linq
@using CampusConnect.Data
@using CampusConnect.Services

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject TablesDbContext Db
@inject INotificationService Notifications

@{
    var canSeeNotifications = User?.Identity?.IsAuthenticated == true &&
        (User.IsInRole("User") || User.IsInRole("Staff") || User.IsInRole("Manager") || User.IsInRole("Admin"));
}

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        // Default fallback (what you had before)
        var displayName = UserManager.GetUserName(User) ?? "User";

        // Identity user id (AspNetUsers.Id)
        var identityUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var unreadCount = 0;
        var recentNotifications = new List<CampusConnect.Models.notification>();

        if (!string.IsNullOrWhiteSpace(identityUserId))
        {
            // Link Identity -> your app user profile table
            var appUser = await Db.users
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.identityUserId == identityUserId);

            if (appUser != null)
            {
                // Prefer First + Last name, then fallback
                var fullName = $"{appUser.fName} {appUser.lName}".Trim();

                if (!string.IsNullOrWhiteSpace(fullName))
                    displayName = fullName;
                else if (!string.IsNullOrWhiteSpace(appUser.username))
                    displayName = appUser.username;
                else if (!string.IsNullOrWhiteSpace(appUser.email))
                    displayName = appUser.email;
            }

            if (canSeeNotifications)
            {
                unreadCount = await Notifications.GetUnreadCountForIdentityUserAsync(identityUserId);
                recentNotifications = await Notifications.GetRecentForIdentityUserAsync(identityUserId, 6);
            }
        }

        <li class="nav-item">
            <a id="manage" class="nav-link text-dark"
               asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Hello @displayName!
            </a>
        </li>
        @if (canSeeNotifications)
        {
            <li class="nav-item dropdown">
                <a class="nav-link text-dark dropdown-toggle position-relative"
                   href="#"
                   id="notificationsDropdown"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false"
                   title="Notifications">
                    <svg aria-hidden="true"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg"
                         style="vertical-align: text-bottom;">
                        <path d="M15 17H5.5C6.3 16.2 7 15.1 7 14V10C7 7.2 8.7 4.8 11.2 3.8C11.7 3.6 12 3.2 12 2.7C12 2.3 12.3 2 12.7 2H13.3C13.7 2 14 2.3 14 2.7C14 3.2 14.3 3.6 14.8 3.8C17.3 4.8 19 7.2 19 10V14C19 15.1 19.7 16.2 20.5 17H15Z"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                        <path d="M10.5 18C10.8 19.2 11.8 20 13 20C14.2 20 15.2 19.2 15.5 18"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                    @if (unreadCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @unreadCount
                        </span>
                    }
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationsDropdown" style="min-width: 340px;">
                    <li class="dropdown-header d-flex justify-content-between align-items-center">
                        <span>Notifications</span>
                        @if (unreadCount > 0)
                        {
                            <span class="badge bg-primary">@unreadCount new</span>
                        }
                    </li>

                    @if (recentNotifications.Any())
                    {
                        @foreach (var notification in recentNotifications)
                        {
                            <li>
                                <a class="dropdown-item text-wrap @(notification.isRead ? "" : "fw-bold")"
                                   asp-page="/Notifications/Go"
                                   asp-route-notificationId="@notification.id">
                                    <div>@notification.title</div>
                                    <div class="small text-muted">@notification.message</div>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li><span class="dropdown-item-text text-muted">No notifications yet.</span></li>
                    }

                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-page="/Notifications/Index">View all notifications</a></li>
                </ul>
            </li>
        }
        <li class="nav-item">
            <form id="logoutForm" class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Page("/Index", new { area = "" })"
                  method="post">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
