@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

    bool isHome = currentPage == "/Index" || currentPage == "/" || currentPage == "/Manager/Index";
    bool isPrivacy = currentPage == "/Privacy";
    bool isSubmitRequest = currentPage == "/RequestPages/Create";
    bool isMyRequests = currentPage == "/RequestPages/MyRequests";
    bool isQueue = currentPage == "/Manager/Queue";
    bool isReviewRequests = currentPage == "/Manager/ReviewRequests";
    bool isArchive = currentPage == "/Manager/Archive";
    bool isAIInsights = currentPage == "/Manager/AIInsights/Index";
    bool isTestMongo = currentPage == "/Admin/TestMongo";
    bool isActivityLogs = currentPage == "/Admin/ActivityLogs/Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusConnect.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">CampusConnect</a>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbarCollapse"
                        aria-controls="mainNavbarCollapse"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="mainNavbarCollapse">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active fw-bold text-primary" : "text-dark")"
                               asp-area="" asp-page="/Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isPrivacy ? "active fw-bold text-primary" : "text-dark")"
                               asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isSubmitRequest ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/RequestPages/Create">Submit Request</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isMyRequests ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/RequestPages/MyRequests">My Requests</a>
                            </li>
                        }

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/StaffPages/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/StaffPages/Queue">Request Queue</a>
                            </li>
                        }
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isQueue ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/Queue">Queue</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isReviewRequests ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/ReviewRequests">Review Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isArchive ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/Archive">Archive</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isAIInsights ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/AIInsights/Index">
                                    <i class="bi bi-lightbulb"></i> AI Insights
                                </a>
                            </li>
                        }
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isTestMongo ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Admin/TestMongo">
                                    <i class="bi bi-database"></i> MongoDB Test
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isActivityLogs ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Admin/ActivityLogs/Index">
                                    <i class="bi bi-clock-history"></i> Activity Logs
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CampusConnect -
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
