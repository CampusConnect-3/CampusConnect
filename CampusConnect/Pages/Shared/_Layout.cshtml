@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();

    bool isHome = currentPage == "/Index" || currentPage == "/" || currentPage == "/Manager/Index";
    bool isSubmitRequest = currentPage == "/RequestPages/Create";
    bool isMyRequests = currentPage == "/RequestPages/MyRequests";
    bool isQueue = currentPage == "/Manager/Queue";
    bool isReviewRequests = currentPage == "/Manager/ReviewRequests";
    bool isArchive = currentPage == "/Manager/Archive";
    bool isAIInsights = currentPage == "/Manager/AIInsights/Index";
    bool isTestMongo = currentPage == "/Admin/TestMongo";
    bool isActivityLogs = currentPage == "/Admin/ActivityLogs/Index";
    bool isCreateUser = currentPage == "/Admin/UserPages/Create";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusConnect</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusConnect.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/png" href="~/images/campus-connect-logo.png" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <span class="navbar-brand">
                    <img src="~/images/campus-connect-logo.png" alt="CampusConnect Logo" style="height:52px;" />
                </span>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbarCollapse"
                        aria-controls="mainNavbarCollapse"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between" id="mainNavbarCollapse">
                    <ul class="navbar-nav flex-grow-1">

                        @* Home - all roles *@
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active fw-bold text-primary" : "text-dark")"
                               asp-area="" asp-page="/Index">
                                <i class="bi bi-house-fill"></i> Home
                            </a>
                        </li>

                        @* User role nav *@
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isSubmitRequest ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/RequestPages/Create">
                                    <i class="bi bi-plus-circle"></i> Submit Request
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isMyRequests ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/RequestPages/MyRequests">
                                    <i class="bi bi-list-check"></i> My Requests
                                </a>
                            </li>
                        }

                        @* Staff role nav *@
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/StaffPages/Dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/StaffPages/Queue">
                                    <i class="bi bi-inbox"></i> Request Queue
                                </a>
                            </li>
                        }

                        @* Manager role nav *@
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isQueue ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/Queue">
                                    <i class="bi bi-kanban"></i> Queue
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isReviewRequests ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/ReviewRequests">
                                    <i class="bi bi-clipboard-check"></i> Review Requests
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isArchive ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/Archive">
                                    <i class="bi bi-archive"></i> Archive
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isAIInsights ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/AIInsights/Index">
                                    <i class="bi bi-lightbulb"></i> AI Insights
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Manager/Analytics" ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Manager/Analytics">
                                    <i class="bi bi-graph-up"></i> Analytics
                                </a>
                            </li>
                        }

                        @* Admin role nav *@
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(isCreateUser ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Admin/UserPages/Create">
                                    <i class="bi bi-person-plus"></i> Create User
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isTestMongo ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Admin/TestMongo">
                                    <i class="bi bi-robot"></i> AI Sync & Insights
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isActivityLogs ? "active fw-bold text-primary" : "text-dark")"
                                   asp-page="/Admin/ActivityLogs/Index">
                                    <i class="bi bi-clock-history"></i> Activity Logs
                                </a>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CampusConnect
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
